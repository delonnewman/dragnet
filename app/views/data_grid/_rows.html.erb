<% grid.records.each do |record| %>
  <tr id="<%= dom_id record %>">
    <td class="text-nowrap text-muted align-middle">
      <%= fmt_datetime record.created_at %>
    </td>
    <td class="text-nowrap text-muted align-middle">
      <%= record.user&.name || '-' %>
    </td>
    <% grid.questions.each do |question| %>
      <td><%= answers_text record, question %></td>
    <% end %>
    <td>
      <%= link_to edit_survey_data_row_path(grid.survey, record),
            class: 'btn btn-sm btn-dark',
            'hx-get': edit_survey_data_row_path(grid.survey, record),
            'hx-target': "##{dom_id record}",
            'hx-swap': 'outerHTML' do %>
        <%= icon 'fas', 'pencil' %>
      <% end %>
      <button
        type="button"
        class="btn btn-sm btn-danger"
        hx-delete="<%= survey_data_row_path(grid.survey, record) %>"
        hx-target="#data-grid-rows"
        hx-confirm="Are you sure you want to delete this row?"
      >
        <%= icon 'fas', 'trash' %>
      </button>
    </td>
  </tr>
<% end %>

<% if grid.show_load_more? %>
  <tr
    id="the-end"
    hx-get="<%= survey_data_rows_path(grid.survey, page: grid.pager.next) %>"
    hx-trigger="revealed"
    hx-swap="outerHTML"
  >
    <td colspan="<%= grid.questions.count + 2 %>">
      <div class="spinner-grow" role="status">
        <span class="visually-hidden">Loading...</span>
      </div>
    </td>
  </tr>
<% end %>
