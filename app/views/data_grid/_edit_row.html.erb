<tr id="<%= dom_id record %>">
  <td class="text-nowrap text-muted align-middle">
    <%= fmt_datetime record.created_at %>
  </td>
  <td class="text-nowrap text-muted align-middle">
    <%= record.user&.name || '-' %>
  </td>
  <% grid.questions.each do |question| %>
    <%# TODO: eventually we'll need a more complete answer to answers with multiple values %>
    <% answers = record.answers_to(question) %>
    <td>
      <%= hidden_field_tag field_name(:reply, :answers_attributes, question.id, :id), answers.first&.id %>
      <%= hidden_field_tag field_name(:reply, :answers_attributes, question.id, :question_id), question.id %>
      <%= hidden_field_tag field_name(:reply, :answers_attributes, question.id, :survey_id), grid.survey_id %>
      <input
        type="text"
        id="<%= dom_id(record, question.id) %>"
        name="<%= field_name(:reply, :answers_attributes, question.id, :value) %>"
        value="<%= answers.join(' ') %>"
      >
    </td>
  <% end %>
  <td>
    <button
      class="btn btn-sm btn-success"
      type="button"
      hx-patch="<%= survey_data_row_path(grid.survey, record) %>"
      hx-target="#data-grid-rows"
      hx-swap="innerHTML"
      hx-include="closest tr"
    >
      <%= icon 'fas', 'check' %>
    </button>
    <button
      class="btn btn-sm btn-warning"
      type="button"
      hx-confirm="Are you sure you want to cancel your edits?"
      hx-get="<%= survey_data_rows_path(grid.survey) %>"
      hx-target="#data-grid-rows"
    >
      <%= icon 'fas', 'times' %>
    </button>
  </td>
</tr>
